{
    "modules-center": [
        "custom/clock"
    ],
    "custom/clock": {
        "exec": "waybar-calendar clock render",
        "return-type": "json",
        "interval": 5,
        "signal": 9,
        "tooltip": true,
        "on-click": "waybar-calendar clock toggle",
        "on-scroll-down": "waybar-calendar clock open",
        "on-scroll-up": "waybar-calendar clock close"
    }
}
